# Copy to .env (gitignored) and fill in.

# Ollama cloud (LLM summaries / fit score)
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_FALLBACK_MODEL=gpt-oss:20b

# Bearer token for /mcp (>= 24 chars):   openssl rand -hex 32
# It is also shown in the dashboard's Connect Claude button (the dashboard is password-protected).
MCP_TOKEN=

# Dashboard password hash for user "seizury":
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the SINGLE quotes: the hash contains $ signs.
BANDI_DASH_HASH=''

# Optional
# BANDI_RUN_AT=07:00        daily run time (Europe/Rome)
# PUID=1000                 owner of the files in ./state (id -u on the server)
# PGID=1000
